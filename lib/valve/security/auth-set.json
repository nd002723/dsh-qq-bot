      "hint": "逗号分隔。有群管理权限，但不能永久授权",
      "numeric": true,
      "tab": "basic",
      "subtab": "access"
    },
    {
      "path": [
        "auth",
        "grantTtlMinutes"
      ],
      "label": "动态授权默认时长（分钟）",
