{
  "priority": 100,
  "fields": [
    {
      "path": [
        "protocol"
      ],
      "label": "协议",
      "kind": "select",
      "hint": "底层聊天协议；切换后适配器自动重启。OneBot 11 兼容既有配置，QQ 官方机器人选 qq-official",
      "options": [
        [
          "onebot11",
          "OneBot 11（NapCat / go-cqhttp / Lagrange）"
        ],
        [
          "onebot12",
          "OneBot 12"
        ],
        [
          "satori",
          "Satori（Koishi 生态）"
        ],
        [
          "milky",
          "Milky（NapCat / Yogurt / Lagrange.Milky）"
        ],
        [
          "qq-official",
          "QQ 官方机器人开放平台 API v2"
        ]
      ],
      "tab": "connection"
    },
    {
      "path": [
        "mode"
      ],
      "label": "连接方式",
      "kind": "select",
      "hint": "正向 = DSH 主动连 NapCat（同机/同容器最简单）；反向 = NapCat 连 DSH（跨容器/跨网络）",
      "options": [
        [
          "forward",
          "正向 WebSocket（DSH → NapCat）"
        ],
        [
          "reverse",
          "反向 WebSocket（NapCat → DSH）"
        ]
      ],
      "tab": "connection"
    },
    {
      "path": [
        "onebot",
        "wsUrl"
      ],
      "label": "正向 WS 地址",
      "kind": "text",
      "placeholder": "ws://127.0.0.1:3001",
      "when": {
        "mode": {
          "$ne": "reverse"
        }
      },
      "tab": "connection"
    },
    {
      "path": [
        "onebot",
        "listen"
      ],
      "label": "反向 WS 监听地址",
      "kind": "text",
      "placeholder": "0.0.0.0:6199",
      "when": {
        "mode": "reverse"
      },
      "tab": "connection"
    },
    {
      "path": [
        "onebot",
        "httpUrl"
      ],
      "label": "HTTP API 地址",
      "kind": "text",
      "hint": "留着用来发消息；清空则退回用 WebSocket action",
      "placeholder": "http://127.0.0.1:3000",
      "tab": "connection"
    },
    {
      "path": [
        "onebot",
        "accessToken"
      ],
      "label": "access_token",
      "kind": "password",
      "hint": "NapCat 里设了 token 就填这里",
      "tab": "connection"
    },
    {
      "path": [
        "protocols",
        "onebot12",
        "mode"
      ],
      "label": "OneBot 12 接入方式",
      "kind": "select",
      "hint": "决定下面填「正向 WS 地址」还是「反向 WS 监听」",
      "options": [
        [
          "forward",
          "正向 WebSocket（DSH → 端）"
        ],
        [
          "reverse",
          "反向 WebSocket（端 → DSH）"
        ]
      ],
      "when": {
        "protocol": "onebot12"
      },
      "tab": "connection"
    },
    {
      "path": [
        "protocols",
        "onebot12",
        "wsUrl"
      ],
      "label": "OneBot 12 正向 WS",
      "kind": "text",
      "placeholder": "ws://127.0.0.1:3001",
      "when": {
        "protocol": "onebot12",
        "protocols.onebot12.mode": {
          "$ne": "reverse"
        }
      },
      "tab": "connection"
    },
    {
      "path": [
        "protocols",
        "onebot12",
        "listen"
      ],
      "label": "OneBot 12 反向 WS 监听",
      "kind": "text",
      "placeholder": "0.0.0.0:6199",
      "when": {
        "protocol": "onebot12",
        "protocols.onebot12.mode": "reverse"
      },
      "tab": "connection"
    },
    {
      "path": [
        "protocols",
        "onebot12",
        "httpUrl"
      ],
      "label": "OneBot 12 HTTP API",
      "kind": "text",
      "placeholder": "http://127.0.0.1:3000",
      "when": {
        "protocol": "onebot12"
      },
      "tab": "connection"
    },
    {
      "path": [
        "protocols",
        "onebot12",
        "accessToken"
      ],
      "label": "OneBot 12 access_token",
      "kind": "password",
      "when": {
        "protocol": "onebot12"
      },
      "tab": "connection"
    },
    {
      "path": [
        "protocols",
        "satori",
        "wsUrl"
      ],
      "label": "Satori WS 地址",
      "kind": "text",
      "placeholder": "ws://127.0.0.1:5140",
      "when": {
        "protocol": "satori"
      },
      "tab": "connection"
    },
    {
      "path": [
        "protocols",
        "satori",
        "httpUrl"
      ],
      "label": "Satori HTTP API",
      "kind": "text",
      "placeholder": "http://127.0.0.1:5140",
      "when": {
        "protocol": "satori"
      },
      "tab": "connection"
    },
    {
      "path": [
        "protocols",
        "satori",
        "token"
      ],
      "label": "Satori access token",
      "kind": "password",
      "when": {
        "protocol": "satori"
      },
      "tab": "connection"
    },
    {
      "path": [
        "protocols",
        "satori",
        "platform"
      ],
      "label": "Satori 平台标识",
      "kind": "text",
      "placeholder": "qq",
      "when": {
        "protocol": "satori"
      },
      "tab": "connection"
    },
    {
      "path": [
        "protocols",
        "satori",
        "selfId"
      ],
      "label": "Satori bot 自身 id",
      "kind": "text",
      "placeholder": "（留空 = 首条事件取）",
      "when": {
        "protocol": "satori"
      },
      "tab": "connection"
    },
    {
      "path": [
        "protocols",
        "milky",
        "wsUrl"
      ],
      "label": "Milky 事件 WS",
      "kind": "text",
      "placeholder": "ws://127.0.0.1:3010/event",
      "when": {
        "protocol": "milky"
      },
      "tab": "connection"
    },
    {
      "path": [
        "protocols",
        "milky",
        "httpUrl"
      ],
      "label": "Milky API 基址",
      "kind": "text",
      "placeholder": "http://127.0.0.1:3010",
      "when": {
        "protocol": "milky"
      },
      "tab": "connection"
    },
    {
      "path": [
        "protocols",
        "milky",
        "accessToken"
      ],
      "label": "Milky access_token",
      "kind": "password",
      "when": {
        "protocol": "milky"
      },
      "tab": "connection"
    },
    {
      "path": [
        "protocols",
        "qqOfficial",
        "mode"
      ],
      "label": "QQ 官方接入方式",
      "kind": "select",
      "options": [
        [
          "webhook",
          "Webhook 回调"
        ],
        [
          "ws",
          "WebSocket 网关"
        ]
      ],
      "when": {
        "protocol": "qq-official"
      },
      "tab": "connection"
    },
    {
      "path": [
        "protocols",
        "qqOfficial",
        "appId"
      ],
      "label": "AppID",
      "kind": "text",
      "when": {
        "protocol": "qq-official"
      },
      "tab": "connection"
    },
    {
      "path": [
        "protocols",
        "qqOfficial",
        "appSecret"
      ],
      "label": "AppSecret",
      "kind": "password",
      "when": {
        "protocol": "qq-official"
      },
      "tab": "connection"
    },
    {
      "path": [
        "protocols",
        "qqOfficial",
        "botSecret"
      ],
      "label": "Webhook 校验 secret",
      "kind": "password",
      "when": {
        "protocol": "qq-official",
        "protocols.qqOfficial.mode": "webhook"
      },
      "tab": "connection"
    },
    {
      "path": [
        "protocols",
        "qqOfficial",
        "selfId"
      ],
      "label": "机器人 QQ 号（self_id）",
      "kind": "text",
      "hint": "webhook 模式不会有 READY 事件，填了才知道「哪个 @ 是在叫我」；留空则群里任何 @ 都会触发回复",
      "placeholder": "例如 123456789",
      "when": {
        "protocol": "qq-official"
      },
      "tab": "connection"
    },
    {
      "path": [
        "protocols",
        "qqOfficial",
        "listen"
      ],
      "label": "Webhook 监听地址",
      "kind": "text",
      "hint": "端口只能是 80 / 443 / 8080 / 8443",
      "placeholder": "0.0.0.0:8443",
      "when": {
        "protocol": "qq-official",
        "protocols.qqOfficial.mode": "webhook"
      },
      "tab": "connection"
    },
    {
      "path": [
        "protocols",
        "qqOfficial",
        "path"
      ],
      "label": "Webhook 回调路径",
      "kind": "text",
      "placeholder": "/qqbot",
      "when": {
        "protocol": "qq-official",
        "protocols.qqOfficial.mode": "webhook"
      },
      "tab": "connection"
    },
    {
      "path": [
        "group",
        "enabled"
      ],
      "label": "启用群聊",
      "kind": "bool",
      "tab": "basic",
      "subtab": "access"
    },
    {
      "path": [
        "commandPrefix"
      ],
      "label": "命令前缀",
      "kind": "text",
      "hint": "例如 /ai，只有带前缀的消息才会被处理",
      "placeholder": "（留空 = 不限制）",
      "tab": "basic",
      "subtab": "govern"
    },
    {
      "path": [
        "group",
        "requireAt"
      ],
      "label": "群里必须 @ 机器人才回复",
      "kind": "bool",
      "tab": "basic",
      "subtab": "access"
    },
    {
      "path": [
        "limits",
        "perMinute"
      ],
      "label": "每人每分钟最多几条",
      "kind": "number",
      "hint": "同一会话的同一个人每分钟最多驱动几个回合（防刷）",
      "tab": "basic",
      "subtab": "govern",
      "min": 0,
      "max": 200,
      "step": 1,
      "slider": true,
      "unit": "条/分"
    },
    {
      "path": [
        "limits",
        "queueMax"
      ],
      "label": "单会话最多排队几条",
      "kind": "number",
      "hint": "超过就直接拒收，不排队",
      "tab": "basic",
      "subtab": "govern",
      "min": 0,
      "max": 20,
      "step": 1,
      "slider": true,
      "unit": "条"
    },
    {
      "path": [
        "limits",
        "maxChars"
      ],
      "label": "单条消息最大字数（入站）",
      "kind": "number",
      "hint": "超出截断，避免超长文本整段进提示词",
      "tab": "basic",
      "subtab": "govern",
      "min": 0,
      "max": 8000,
      "step": 100,
      "slider": true,
      "unit": "字"
    },
    {
      "path": [
        "group",
        "allow"
      ],
      "label": "群号白名单",
      "kind": "list",
      "hint": "逗号分隔；留空 = 所有群都能用（清空不等于「谁都不许」）。想彻底停掉群聊请关上面的总开关",
      "numeric": true,
      "tab": "basic",
      "subtab": "access"
    },
    {
      "path": [
        "private",
        "enabled"
      ],
      "label": "启用私聊",
      "kind": "bool",
      "tab": "basic",
      "subtab": "access"
    },
    {
      "path": [
        "private",
        "allow"
      ],
      "label": "私聊白名单",
      "kind": "list",
      "hint": "逗号分隔；留空 = 所有人都能私聊（清空不等于「谁都不许」）。想彻底停掉私聊请关上面的总开关",
      "numeric": true,
      "tab": "basic",
      "subtab": "access"
    },
    {
      "path": [
        "admin",
        "enabled"
      ],
      "label": "启用群管理",
      "kind": "bool",
      "hint": "总开关；关掉后指令与 qqgroup 工具都会拒绝",
      "tab": "basic",
      "subtab": "govern"
    },
    {
      "path": [
        "admin",
        "manageGroups"
      ],
      "label": "可管理的群号",
      "kind": "list",
      "hint": "逗号分隔；留空 = 回退用「群号白名单」，再空 = 不限制到群",
      "numeric": true,
      "tab": "basic",
      "subtab": "govern"
    },
    {
      "path": [
        "admin",
        "requireGroupAdmin"
      ],
      "label": "承认「本群管理员」这一路权限",
      "kind": "bool",
      "hint": "关闭后只有静态名单与动态授权生效",
      "tab": "basic",
      "subtab": "govern"
    },
    {
      "path": [
        "admin",
        "prefix"
      ],
      "label": "指令前缀（必须在消息首位）",
      "kind": "text",
      "placeholder": "/",
      "tab": "basic",
      "subtab": "govern"
    },
    {
      "path": [
        "admin",
        "dryRun"
      ],
      "label": "演练模式（只回复将执行什么）",
      "kind": "bool",
      "hint": "先用它确认指令解析是否正确，再关掉真执行",
      "tab": "basic",
      "subtab": "govern"
    },
    {
      "path": [
        "admin",
        "allowConsole"
      ],
      "label": "允许非 QQ 来源调用管理工具",
      "kind": "bool",
      "hint": "例如从 Web UI 会话里直接让 Agent 踢人。注意：它放行的是「一切非 QQ 会话」——模型驱动的子代理、任务板、工作流同样算在内，不是只认你本人操作的那一个页面。默认关闭",
      "tab": "basic",
      "subtab": "govern"
    },
    {
      "path": [
        "session",
        "fixedName"
      ],
      "label": "固定新建会话名（私聊_<QQ号>/群聊_<群号>）",
      "kind": "bool",
      "hint": "开启后新会话不再用 LLM 自动起标题",
      "tab": "advanced",
      "subtab": "session"
    },
    {
      "path": [
        "session",
        "recallArchived"
      ],
      "label": "自动召回已归档会话",
      "kind": "bool",
      "hint": "QQ 消息触发该会话时，把它从 DSH 的「归档」里拉回可见。关闭后：被归档的 QQ 会话新消息不会得到回复（DSH 的归档闸门会直接拒绝该会话的每一步模型请求）",
      "tab": "advanced",
      "subtab": "session"
    },
    {
      "path": [
        "perChatSession"
      ],
      "label": "每个 QQ 会话独立 DSH 会话",
      "kind": "bool",
      "tab": "advanced",
      "subtab": "session"
    },
    {
      "path": [
        "updateCheck",
        "enabled"
      ],
      "label": "探测新版本（设置页提示）",
      "kind": "bool",
      "hint": "启动后最多 6 小时拉一次 npm registry；只提示，不自动升级",
      "tab": "advanced",
      "subtab": "session"
    },
    {
      "path": [
        "logAdapterFrames"
      ],
      "label": "日志打印每一帧（排错）",
      "kind": "bool",
      "tab": "advanced",
      "subtab": "session"
    },
    {
      "path": [
        "agentPresetCustom"
      ],
      "label": "① 自定义 agent preset id（优先级最高）",
      "kind": "text",
      "hint": "如果你不知道你在做什么，最好别动这个。填 DSH 里自建 preset 的 id（例如 qq），它会整档接管人格 + 工具面，这条生效时 ②③ 全被忽略。加装了不影响安全的第三方扩展插件、却没进任何 preset 的，就在自建 preset 的 plugins 里把插件行加进去，再把 id 填到这里——别为了用扩展去改安全相关的项",
      "placeholder": "（留空 = 用下面的③）",
      "tab": "advanced",
      "subtab": "session"
    },
    {
      "priority": 190,
      "path": [
        "agentPreset"
      ],
      "label": "③ Agent preset（兜底）",
      "kind": "select",
      "hint": "如果你不知道你在做什么，最好别动这个。默认 standard。①② 都留空时才用它。优先级：① 自定义 id > ② 拥有者/访客分流 > ③ 本项 > 部署默认。只影响新会话",
      "placeholder": "standard",
      "options": [
        [
          "",
          "（跟随部署默认）"
        ],
        [
          "standard",
          "standard（标准工具面，工具直接可见）"
        ],
        [
          "ptc",
          "ptc（网关模式，工具经 run_code 执行）"
        ],
        [
          "minimal",
          "minimal（极简）"
        ],
        [
          "cordis",
          "cordis（插件开发模式）"
        ]
      ],
      "tab": "advanced",
      "subtab": "session"
    },
    {
