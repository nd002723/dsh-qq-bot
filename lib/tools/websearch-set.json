{
  "priority": 100,
  "group": "webSearch",
  "tab": "capability",
  "subtab": "retrieval",
  "fields": [
    {
      "path": [
        "webSearch",
        "_card"
      ],
      "kind": "card",
      "virtual": true,
      "label": "网络搜索",
      "sub": "按下面的顺序依次尝试；每行可用 ▲ / ▼ 调换（DeepSeek 凭据：官方 key 优先，没有才用登录账号）",
      "hint": "某后端未注册 / 不可用 / 调用失败 / 整批结果没简介时自动降级到下一个，全部失败才报错；用户取消时不重试。",
      "card": {
        "id": "websearch",
        "defaultOpen": false,
        "dataAttr": "data-search-card",
        "toggleAttr": "data-search-open",
        "summary": "auto",
        "body": [
          {
            "in": "websearch"
          },
          {
            "actions": "open"
          },
          {
            "in": "websearch-params",
            "title": "接线参数"
          }
        ],
        "actions": [
          {
            "id": "reset-order",
            "label": "恢复默认顺序",
            "attr": "data-search-restore",
            "onlyWhenOpen": true
          }
        ]
      }
    },
    {
      "path": [
        "webSearch",
        "order"
      ],
      "kind": "searchorder",
      "in": "websearch",
      "label": "搜索后端优先级"
    },
    {
      "path": [
        "webSearch",
        "perQuery"
      ],
      "label": "每查询返回条数",
      "kind": "number",
      "num": {
        "min": 0,
        "max": 50,
        "step": 1,
        "mode": "plain"
      },
      "in": "websearch-params",
      "hint": "每个查询最多保留几条来源，0 表示不接管（沿用各后端自己的默认条数）。实际条数还受后端自身限制。"
    },
    {
      "path": [
        "webSearch",
        "tavilyKey"
      ],
      "label": "Tavily API Key（可选）",
      "kind": "password",
      "in": "websearch-params",
      "secret": true,
      "hint": "填入后搜索优先走 Tavily 官方 API（免费额度 1000 次/月，每次 1 点），用尽后自动降级到免 Key 引擎；留空 = 只读环境变量 TAVILY_API_KEY。",
      "placeholder": "tvly-..."
    },
    {
      "path": [
        "webSearch",
        "proxy"
      ],
      "label": "联网搜索 HTTP 代理",
      "kind": "text",
      "in": "websearch-params",
      "hint": "http://host:port；免 Key 多引擎的请求都经同一套出网策略（网络阀门），留空直连",
      "placeholder": "（留空 = 直连）"
    }
  ]
}
