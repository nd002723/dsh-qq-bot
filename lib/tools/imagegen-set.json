{
  "priority": 300,
  "group": "imageGen",
  "tab": "capability",
  "subtab": "vision",
  "fields": [
    {
      "path": [
        "imageGen",
        "enabled"
      ],
      "label": "生图（qq_draw）",
      "kind": "bool",
      "hint": "开启后 AI 能按描述画图；接口/模型/key 由下面几项决定，插件不内置任何 key"
    },
    {
      "path": [
        "imageGen",
        "baseUrl"
      ],
      "label": "生图 API 地址",
      "kind": "text",
      "hint": "OpenAI 兼容：会请求 <地址>/images/generations",
      "placeholder": "https://api.example.com/v1"
    },
    {
      "path": [
        "imageGen",
        "model"
      ],
      "label": "生图模型",
      "kind": "text",
      "placeholder": "seedream-5.0-lite"
    },
    {
      "path": [
        "imageGen",
        "size"
      ],
      "label": "默认尺寸",
      "kind": "text",
      "placeholder": "1024x1024"
    },
    {
      "path": [
        "imageGen",
        "apiKey"
      ],
      "label": "生图 API key",
      "kind": "password",
      "hint": "只写字段：已设置时留空表示保持不变。生图只认这里或下面的环境变量，不再给主动发言兜底",
      "placeholder": "（留空 = 读下面的环境变量）"
    },
    {
      "path": [
        "imageGen",
        "apiKeyEnv"
      ],
      "label": "API key 环境变量名",
      "kind": "text",
      "hint": "上一条留空时才读它；这是生图自己的回退链，主动发言已不再取 key",
      "placeholder": "IMAGE_API_KEY"
    },
    {
      "path": [
        "imageGen",
        "maxAttempts"
      ],
      "label": "失败重试次数（含首次）",
      "kind": "number",
      "hint": "429 / 5xx / 网络错 / 空结果会重试；4xx 直接报错不重试",
      "min": 1,
      "max": 10,
      "step": 1,
      "slider": true,
      "unit": "次"
    },
    {
      "path": [
        "imageGen",
        "retryIntervalMs"
      ],
      "label": "重试间隔（毫秒）",
      "kind": "number",
      "min": 0,
      "max": 60000,
      "step": 500,
      "slider": true,
      "unit": "毫秒"
    },
    {
      "path": [
        "imageGen",
        "poll"
      ],
      "label": "返回 task_id 时继续轮询",
      "kind": "bool",
      "hint": "异步生图的供应商才有用：关掉则只尝试一次"
    },
    {
      "path": [
        "imageGen",
        "pollIntervalMs"
      ],
      "label": "轮询间隔（毫秒）",
      "kind": "number",
      "min": 0,
      "max": 60000,
      "step": 500,
      "slider": true,
      "unit": "毫秒"
    },
    {
      "path": [
        "imageGen",
        "maxPolls"
      ],
      "label": "最多轮询次数",
      "kind": "number",
      "min": 0,
      "max": 100,
      "step": 1,
      "slider": true,
      "unit": "次"
    },
    {
      "path": [
        "imageGen",
        "timeoutMs"
      ],
      "label": "单次请求超时（毫秒）",
      "kind": "number",
      "min": 0,
      "max": 300000,
      "step": 1000,
      "slider": true,
      "unit": "毫秒"
    }
  ]
}
