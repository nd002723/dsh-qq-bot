{
  "name": "@sputnikzaychik/dsh-qq-bot",
  "version": "0.13.0",
  "description": "把 QQ 接到 DSH Agent 的插件（社区化维护）：经 NapCat / OneBot 11 收发消息，每个 QQ 会话一个 DSH Agent。",
  "meta": {
    "title": "QQ 机器人",
    "description": "把 QQ 接进 DSH：qqbot / qqgroup / qq_history 管收发与群管理，qq_draw / qq_imgsearch / qq_websearch / qq_webfetch 管绘图、搜图与联网抓取，qq_sticker 发表情包，qqconfig 让拥有者在私聊里改设置。"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./adapter": "./lib/transport/onebot-adapter.mjs",
    "./client": {
      "default": "./lib/client/settings.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.6",
    "dsh": ">=0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "runtime": "host",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0"
    }
  },
  "scripts": {
    "test": "node test/run-all.mjs",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "qq",
    "qqbot",
    "onebot",
    "onebot11",
    "napcat",
    "chatbot",
    "cordis",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arrow1031-dev/dsh-qq-bot.git"
  },
  "bugs": {
    "url": "https://github.com/arrow1031-dev/dsh-qq-bot/issues"
  },
  "homepage": "https://github.com/arrow1031-dev/dsh-qq-bot#readme",
  "author": {
    "name": "arrow1031",
    "url": "https://github.com/arrow1031"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
